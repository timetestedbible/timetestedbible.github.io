---
layout: null
---
[
{% for post in site.posts %}
  {
    "slug": "{{ post.slug }}",
    "date": "{{ post.date | date: '%B %-d, %Y' }}",
    "title": {{ post.title | jsonify }},
    "image": "{{ post.image }}",
    "summary": {{ post.summary | jsonify }},
    "content": {{ post.card_content | jsonify }},
    "hasContent": true
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
