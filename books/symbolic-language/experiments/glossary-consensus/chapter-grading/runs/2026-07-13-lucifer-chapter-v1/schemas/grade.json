{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "overall_verdict": {
      "type": "string",
      "enum": [
        "MEETS_STANDARD",
        "MEETS_WITH_LIMITED_GAPS",
        "UNDERDETERMINED_BY_PACKET",
        "DOES_NOT_MEET_STANDARD"
      ]
    },
    "verdict_reason": {"type": "string"},
    "rule_audit": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "rule": {"type": "string", "enum": ["1", "2", "3", "4"]},
          "result": {"type": "string", "enum": ["PASS", "PARTIAL", "FAIL", "NOT_APPLICABLE"]},
          "reason": {"type": "string"}
        },
        "required": ["rule", "result", "reason"]
      }
    },
    "claim_ledger": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": {"type": "string"},
          "category": {
            "type": "string",
            "enum": [
              "LINGUISTIC_VOCALIZATION",
              "LEXICAL_OR_GRAMMATICAL",
              "SYMBOLIC_DERIVATION",
              "BACKGROUND_HYPOTHESIS",
              "RECIPROCAL_CONSILIENCE",
              "HISTORICAL_OR_ASTRONOMICAL",
              "THEOLOGICAL_SYNTHESIS"
            ]
          },
          "book_candidate": {"type": "string"},
          "strongest_rival": {"type": "string"},
          "book_admission": {"type": "string", "enum": ["PASS", "FAIL", "UNDERDETERMINED", "NOT_APPLICABLE"]},
          "rival_admission": {"type": "string", "enum": ["PASS", "FAIL", "UNDERDETERMINED", "NOT_APPLICABLE"]},
          "comparison": {
            "type": "string",
            "enum": ["BOOK_BETTER_SUPPORTED", "RIVAL_BETTER_SUPPORTED", "UNDERDETERMINED", "NOT_COMPARATIVE"]
          },
          "evidence_origins": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": ["TARGET_CHAPTER", "BACKGROUND_PACKET", "EVALUATOR_KNOWLEDGE", "NONE"]
            }
          },
          "reason": {"type": "string"},
          "gap_owner": {
            "type": "string",
            "enum": [
              "NONE",
              "CHAPTER_MISSING_EVIDENCE",
              "CHAPTER_OVERCLAIM",
              "EVALUATOR_KNOWLEDGE_LIMIT",
              "PROTOCOL_MISSING_RULE"
            ]
          },
          "outcome_changing_evidence": {"type": "string"}
        },
        "required": [
          "claim",
          "category",
          "book_candidate",
          "strongest_rival",
          "book_admission",
          "rival_admission",
          "comparison",
          "evidence_origins",
          "reason",
          "gap_owner",
          "outcome_changing_evidence"
        ]
      }
    },
    "reciprocal_consilience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "verdict": {
          "type": "string",
          "enum": ["VALID", "VALID_BUT_INCOMPLETE", "CIRCULAR", "NOT_ESTABLISHED", "NOT_APPLICABLE"]
        },
        "independent_background_support": {"type": "string"},
        "incremental_target_evidence": {"type": "string"},
        "dependency_or_duplication_risk": {"type": "string"},
        "strongest_rival_joint_model": {"type": "string"},
        "comparative_result": {"type": "string"},
        "reversal_evidence": {"type": "string"}
      },
      "required": [
        "verdict",
        "independent_background_support",
        "incremental_target_evidence",
        "dependency_or_duplication_risk",
        "strongest_rival_joint_model",
        "comparative_result",
        "reversal_evidence"
      ]
    },
    "category_error_audit": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "possible_error": {"type": "string"},
          "present_in_chapter": {"type": "boolean"},
          "explanation": {"type": "string"}
        },
        "required": ["possible_error", "present_in_chapter", "explanation"]
      }
    },
    "claims_pass_as_written": {"type": "array", "items": {"type": "string"}},
    "claims_underdetermined": {"type": "array", "items": {"type": "string"}},
    "claims_fail_gate": {"type": "array", "items": {"type": "string"}},
    "material_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "issue": {"type": "string"},
          "gap_owner": {
            "type": "string",
            "enum": [
              "CHAPTER_MISSING_EVIDENCE",
              "CHAPTER_OVERCLAIM",
              "EVALUATOR_KNOWLEDGE_LIMIT",
              "PROTOCOL_MISSING_RULE"
            ]
          },
          "why_material": {"type": "string"},
          "minimal_fix_or_test": {"type": "string"}
        },
        "required": ["issue", "gap_owner", "why_material", "minimal_fix_or_test"]
      }
    },
    "minimal_revisions": {
      "type": "array",
      "maxItems": 5,
      "items": {"type": "string"}
    },
    "no_bloat_recommendation": {"type": "string"},
    "confidence": {"type": "string", "enum": ["HIGH", "MEDIUM", "LOW"]}
  },
  "required": [
    "overall_verdict",
    "verdict_reason",
    "rule_audit",
    "claim_ledger",
    "reciprocal_consilience",
    "category_error_audit",
    "claims_pass_as_written",
    "claims_underdetermined",
    "claims_fail_gate",
    "material_gaps",
    "minimal_revisions",
    "no_bloat_recommendation",
    "confidence"
  ]
}
