{
  "name": "timetested-bible",
  "version": "2.2.0",
  "description": "Time Tested Bible Study App",
  "main": "main.js",
  "scripts": {
    "start": "unset ELECTRON_RUN_AS_NODE && electron .",
    "start:dev": "unset ELECTRON_RUN_AS_NODE && electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux"
  },
  "author": {
    "name": "Time Tested",
    "email": "app@timetested.bible"
  },
  "homepage": "https://timetested.bible",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.timetested.bible",
    "productName": "Time Tested Bible",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js"
    ],
    "extraResources": [
      {
        "from": "../../_site",
        "to": "app",
        "filter": [
          "**/*",
          "!.DS_Store"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.reference",
      "icon": "../../icons/icon-512.png",
      "target": [
        "dmg",
        "zip"
      ],
      "identity": null
    },
    "win": {
      "icon": "../../icons/icon-512.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "icon": "../../icons/icon-512.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education"
    }
  }
}
