{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Time Tested Bible",
  "version": "2.3.0",
  "identifier": "bible.timetested.desktop",
  "build": {
    "frontendDist": "../frontend-stub"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Time Tested Bible",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 600,
        "url": "app://localhost/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../desktop-site": "_site"
    }
  }
}
